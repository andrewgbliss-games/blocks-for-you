; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Blocks For You"
run/main_scene="uid://b0pya2q1jm25u"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://cexb4qmpnjy5b"
config/icon="uid://defhnfuae1jul"
config/windows_native_icon="res://assets/img/icons/icon-1024.ico"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"npc": "res://timelines/characters/npc.dch",
"player": "res://timelines/characters/player.dch"
}
directories/dtl_directory={
"npc": "res://timelines/npc.dtl"
}
layout/style_directory={}

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[global_group]

player=""

